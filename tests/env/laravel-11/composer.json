    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/passport": "^12.0",
        "laravel/cashier": "^15.0",
        "laravel/telescope": "^5.0",
        "doctrine/dbal": "^3.0",
        "spatie/once": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0"
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
