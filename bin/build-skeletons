#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Build the checked-in Laravel skeleton snapshots used by the upgrade tool.
 *
 * This development-time command fetches pinned upstream tags. `--check` is
 * offline and verifies provenance, content, size and file modes; add
 * `--remote` when network access is intentionally available to verify the
 * pinned refs as well.
 */

$root = realpath(dirname(__DIR__));

if ($root === false) {
    fwrite(STDERR, "Could not resolve the package root.\n");
    exit(1);
}

$autoload = $root.'/vendor/autoload.php';

if (! is_file($autoload)) {
    fwrite(STDERR, "Composer autoload files are required; run composer install first.\n");
    exit(1);
}

require $autoload;

exit((new MuhammadSadeeq\LaravelUpgradesRector\Upgrade\Skeleton\SkeletonBuilder($root))->run(array_slice($argv, 1)));
