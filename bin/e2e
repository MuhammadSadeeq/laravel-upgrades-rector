        throw new RuntimeException('config:clear failed');
    }

    run('php artisan about', $app, $aboutExit);

    if ($aboutExit !== 0) {
        throw new RuntimeException('artisan about failed');
    }
});

check('migrations run on sqlite', static function () use ($app): void {
    $envFile = $app.'/.env';
    $databasePath = $app.'/database/database.sqlite';
    $environment = file_get_contents($envFile);

    if (! is_string($environment)) {
        throw new RuntimeException('Could not read the application .env file for sqlite migration setup');
    }

    $connectionLine = 'DB_CONNECTION=sqlite';
    $databaseLine = 'DB_DATABASE="'.addcslashes($databasePath, '\\"').'"';
    $append = [];
    $connectionMatches = 0;
    $databaseMatches = 0;
    $environment = preg_replace_callback(
        '/^DB_CONNECTION=.*$/m',
        static fn (array $match): string => $connectionLine,
        $environment,
        -1,
        $connectionMatches,
    );
    $environment = is_string($environment) ? $environment : null;
    $environment = $environment === null ? null : preg_replace_callback(
        '/^DB_DATABASE=.*$/m',
        static fn (array $match): string => $databaseLine,
        $environment,
        -1,
        $databaseMatches,
    );

    if (! is_string($environment)) {
        throw new RuntimeException('Could not update the application .env file for sqlite migration setup');
    }

    if ($connectionMatches === 0) {
        $append[] = $connectionLine;
    }

    if ($databaseMatches === 0) {
        $append[] = $databaseLine;
    }

    if ($append !== []) {
        $environment = rtrim($environment, "\r\n")."\n".implode("\n", $append)."\n";
    }

    if (file_put_contents($envFile, $environment) === false || ! touch($databasePath)) {
        throw new RuntimeException('Could not configure the sqlite database fixture');
    }

    // Clear the old config cache before checking that Laravel resolves the
    // intended database file rather than the stock DB_DATABASE=laravel value.
    run('php artisan config:clear', $app, $configExit);

    if ($configExit !== 0) {
        throw new RuntimeException('config:clear failed before migration');
    }

    $probePath = $app.'/database-path-check.php';
    $probe = <<<'PHP'
<?php

declare(strict_types=1);

require __DIR__.'/vendor/autoload.php';
$application = require __DIR__.'/bootstrap/app.php';
$application->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
$connection = $application->make('config')->get('database.default');
$database = $application->make('config')->get('database.connections.'.$connection.'.database');

if ($connection !== 'sqlite' || $database !== $argv[1]) {
    fwrite(STDERR, sprintf("Resolved %s database %s; expected sqlite %s.\n", $connection, (string) $database, $argv[1]));

    exit(1);
}
PHP;

    if (file_put_contents($probePath, $probe) === false) {
        throw new RuntimeException('Could not create the sqlite configuration probe');
    }

    run(sprintf('php %s %s', escapeshellarg($probePath), escapeshellarg($databasePath)), $app, $probeExit);
    unlink($probePath);

    if ($probeExit !== 0) {
        throw new RuntimeException('Laravel did not resolve the intended sqlite database path');
    }

    run('php artisan migrate --force', $app, $exit, 600);

    if ($exit !== 0) {
        throw new RuntimeException('migrate failed');
    }

    if (is_file($app.'/laravel')) {
        throw new RuntimeException('migration unexpectedly created a root-level laravel database file');
    }
});

check('test suite passes', static function () use ($app): void {
    run('php artisan test --compact', $app, $exit, 900);

    if ($exit !== 0) {
        throw new RuntimeException('project tests failed');
    }
});

if ($failures === []) {
    check('normalized upgrade diff matches its committed snapshot', static function () use ($app, $repoRoot, $from, $to, $structure): void {
        assertDiffSnapshot($app, $repoRoot, $from, $to, $structure);
    });
} else {
    echo "\n=== normalized upgrade diff matches its committed snapshot ===\n";
    echo "↷ deferred because an earlier E2E check failed; no snapshot will be written.\n";
}

if ($failures === []) {
    check('normalized findings match their committed snapshot', static function () use ($app, $repoRoot, $from, $to, $structure): void {
        assertFindingsSnapshot($app, $repoRoot, $from, $to, $structure);
    });
} else {
    echo "\n=== normalized findings match their committed snapshot ===\n";
    echo "↷ deferred because an earlier E2E check failed; no snapshot will be written.\n";
}

echo "\n========================================\n";

if ($failures !== []) {
    echo "E2E FAILED ({$from} -> {$to}):\n - ".implode("\n - ", $failures)."\n";
    echo "App kept for inspection: {$app}\n";

    exit(1);
}

echo "E2E PASSED ({$from} -> {$to})\n";
echo "Cleaning up {$app}\n";
run('rm -rf '.escapeshellarg($app), dirname($app));
