    run(sprintf(
        'vendor/bin/laravel-upgrade to %d --structure=%s --composer %s --no-interaction --no-pint --no-git',
        $to,
        escapeshellarg($structure),
        escapeshellarg($composerProxy),
    ), $app, $exit, 1800);

    if ($exit !== 3) {
        throw new RuntimeException("injected solver failure exited {$exit}, expected 3");
