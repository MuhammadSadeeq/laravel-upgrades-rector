    assertFailedStateSchema($state, $from, $to, $composerProxy, $structure);
    $failedRunId = $state['runId'];
});

check('continue resumes the orchestrator run', static function () use ($app, $to, $structure, $composerProxy): void {
    // Continue deliberately receives no tool or policy overrides. The failed
    // journal must provide the Composer proxy and no-git/no-pint choices.
    run('vendor/bin/laravel-upgrade continue --no-interaction', $app, $exit, 2400);

    // The Laravel 11 plant deliberately includes duplicate route names to
    // exercise the Laravel 12 verification finding. Keep that useful legacy
    // fixture, assert the exact failed transition, then make the documented
    // manual fix and continue from the same journal without overrides.
    if ($to === 12) {
        if ($exit !== 1) {
            throw new RuntimeException("first continue exited {$exit}, expected verification exit 1");
        }

        $state = readJsonFile($app.'/.laravel-upgrade/state.json');

        if (($state['status'] ?? null) !== 'failed'
            || ($state['failedStep'] ?? null) !== 'verify'
            || ($state['currentTransition'] ?? null) !== '11->12') {
            throw new RuntimeException('first continue did not journal the expected verification failure');
        }

        assertStateOptions($state, $composerProxy, $structure);

        $completed = $state['completedSteps']['11->12'] ?? null;
        $expectedCompleted = array_slice(canonicalUpgradeSteps(), 0, 7);

        if (! is_array($completed) || array_keys($completed) !== $expectedCompleted) {
            throw new RuntimeException('verification failure state has unexpected completed step identities');
        }

        foreach ($completed as $step) {
            if (! is_array($step) || ($step['status'] ?? null) !== 'completed'
                || ! is_string($step['message'] ?? null)
                || ! is_string($step['completedAt'] ?? null)
                || ! is_array($step['changedFiles'] ?? null)
                || ! is_int($step['findingsCount'] ?? null)) {
                throw new RuntimeException('verification failure state has malformed completed step metadata');
            }
        }

        $routePath = $app.'/routes/api.php';
        $route = file_get_contents($routePath);
        $duplicate = "Route::get('/api/home', fn () => 'home')->name('dashboard');";

        if (! is_string($route) || ! str_contains($route, $duplicate)) {
            throw new RuntimeException('duplicate route plant was not found for its manual fix');
        }

        if (file_put_contents($routePath, str_replace(
            $duplicate,
            "Route::get('/home', fn () => 'home')->name('home');",
            $route,
        )) === false) {
            throw new RuntimeException('could not apply the duplicate route manual fix');
        }

        run('vendor/bin/laravel-upgrade continue --no-interaction', $app, $exit, 2400);
    }

    if ($to !== 12 && $exit !== 0) {
        throw new RuntimeException("continue exited {$exit}, expected 0");
    }

    if ($exit !== 0) {
        throw new RuntimeException("fixed continue exited {$exit}");
    }

    if (is_file($app.'/.laravel-upgrade/state.json')) {
        throw new RuntimeException('completed continue left an active state journal');
    }
});

