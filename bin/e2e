#!/usr/bin/env php
<?php

declare(strict_types=1);

use Symfony\Component\Process\Process;

/**
 * End-to-end upgrade harness (plan P1-05).
 *
 * Usage: php bin/e2e <from-major> <to-major> [keep|modern]
 *
 * Creates a real Laravel application, plants realistic upgrade-triggering
 * files, installs this package from the local checkout, and runs the
 * journaled `laravel-upgrade to <target>` flow. The first apply intentionally
 * injects one Composer solver failure; `continue` then resumes the same run.
 * The harness asserts:
 *
 * - `to --plan` leaves the tree byte-identical except for plan.json;
 * - each orchestrator transition records preflight/deps/install/skeleton/
 *   code/advisories/post/verify/report state;
 * - an injected solver failure is journaled and `continue` resumes it;
 * - composer validate --strict passes after applying;
 * - every changed PHP file lints;
 * - every changed class loads against the upgraded autoloader;
 * - the app boots (artisan about), migrates (sqlite) and passes its tests;
 * - the SECOND rector pass produces zero changes (idempotency);
 * - an expected subset of rules actually ran.
 * - the report findings match a reviewed rule-id/file snapshot.
 */
if ($argc < 3 || $argc > 4) {
    fwrite(STDERR, "Usage: php bin/e2e <from-major> <to-major> [keep|modern]\n");

    exit(1);
}

$from = (int) $argv[1];
$to = (int) $argv[2];
$structure = $argc === 4 ? (string) $argv[3] : 'keep';

if (! in_array([$from, $to], [[10, 11], [11, 12], [12, 13]], true)) {
    fwrite(STDERR, "Supported E2E paths are 10 -> 11, 11 -> 12, and 12 -> 13.\n");

    exit(1);
}

if (! in_array($structure, ['keep', 'modern'], true)
    || ($structure === 'modern' && [$from, $to] !== [10, 11])) {
    fwrite(STDERR, "The optional E2E structure must be keep, or modern only for 10 -> 11.\n");

    exit(1);
}

$repoRoot = realpath(dirname(__DIR__));

if (! is_string($repoRoot)) {
    fwrite(STDERR, "Could not resolve repo root.\n");

    exit(1);
}

$failures = [];

function run(string $command, string $cwd, ?int &$exitCode = null, ?int $timeout = 900): string
{
    $process = Process::fromShellCommandline($command, $cwd);
    $process->setTimeout($timeout ?? 900);
    $process->run(static function (string $type, string $buffer): void {
        echo $buffer;
    });
    $exitCode = $process->getExitCode() ?? 1;

    return $process->getOutput();
}

function check(string $name, callable $assertion): void
{
    global $failures;

    echo "\n=== {$name} ===\n";

    try {
        $assertion();
        echo "✔ {$name}\n";
    } catch (Throwable $throwable) {
        $failures[] = $name.': '.$throwable->getMessage();
        echo "✘ {$name}: ".$throwable->getMessage()."\n";
    }
}

/**
 * Write a Composer proxy that fails exactly one solver dry-run, then delegates
 * every command to the real Composer binary. This keeps the resume assertion
 * deterministic without a fake dependency graph or a network-only test.
 */
function createSolverFailureComposer(string $directory): string
{
    $path = $directory.'/.e2e-composer';
    $marker = $directory.'/.e2e-composer-solver-failed';
    $script = <<<'PHP'
#!/usr/bin/env php
<?php

declare(strict_types=1);

$marker = __E2E_MARKER__;
$arguments = array_slice($argv, 1);

if (in_array('update', $arguments, true)
    && in_array('--dry-run', $arguments, true)
    && ! is_file($marker)) {
    file_put_contents($marker, "failed\n");
    fwrite(STDERR, "Injected E2E Composer solver failure.\n");

    exit(3);
}

$composer = getenv('E2E_REAL_COMPOSER');
$composer = is_string($composer) && $composer !== '' ? $composer : 'composer';
$process = proc_open(
    array_merge([$composer], $arguments),
    [0 => STDIN, 1 => STDOUT, 2 => STDERR],
    $pipes,
);

if (! is_resource($process)) {
    fwrite(STDERR, "Could not launch the real Composer binary.\n");

    exit(127);
}

$exitCode = proc_close($process);

exit(is_int($exitCode) ? $exitCode : 1);
PHP;
    $script = str_replace('__E2E_MARKER__', var_export($marker, true), $script);

    if (file_put_contents($path, $script) === false || ! chmod($path, 0755)) {
        throw new RuntimeException('Could not create the Composer failure proxy.');
    }

    return $path;
}

/** Add deliberately customized global/group middleware, an alias, and a route. */
function prepareModernStructureFixture(string $directory): void
{
    $kernelPath = $directory.'/app/Http/Kernel.php';
    $kernel = file_get_contents($kernelPath);

    if (! is_string($kernel)) {
        throw new RuntimeException('Could not read the Laravel 10 HTTP Kernel for the modern fixture.');
    }

    $globalNeedle = "        \\App\\Http\\Middleware\\TrustProxies::class,\n";
    $globalReplacement = "        \\App\\Http\\Middleware\\TrustProxies::class,\n        \\App\\Http\\Middleware\\E2eGlobalProbe::class,\n";

    if (substr_count($kernel, $globalNeedle) !== 1) {
        throw new RuntimeException('The Laravel 10 HTTP Kernel fixture no longer has its stock global stack.');
    }

    $kernel = str_replace($globalNeedle, $globalReplacement, $kernel);
    $groupNeedle = "            \\Illuminate\\Routing\\Middleware\\SubstituteBindings::class,\n        ],\n\n        'api'";
    $groupReplacement = "            \\Illuminate\\Routing\\Middleware\\SubstituteBindings::class,\n            \\App\\Http\\Middleware\\E2eProbe::class,\n        ],\n\n        'api'";

    if (substr_count($kernel, $groupNeedle) !== 1) {
        throw new RuntimeException('The Laravel 10 HTTP Kernel fixture no longer has its stock web group.');
    }

    $kernel = str_replace($groupNeedle, $groupReplacement, $kernel);
    $aliasNeedle = '    protected $middlewareAliases = [';
    $aliasReplacement = <<<'KERNEL'
    protected $middlewareAliases = [
        'e2e-probe' => \App\Http\Middleware\E2eProbe::class,
KERNEL;

    if (! str_starts_with($aliasReplacement, '    protected $middlewareAliases = [')
        || ! str_contains($aliasReplacement, "        'e2e-probe' => \\App\\Http\\Middleware\\E2eProbe::class,")) {
        throw new RuntimeException('The modern fixture alias replacement is malformed before it is applied.');
    }

    if (substr_count($kernel, $aliasNeedle) !== 1) {
        throw new RuntimeException('The Laravel 10 HTTP Kernel fixture no longer has its stock alias map.');
    }

    $kernel = str_replace($aliasNeedle, $aliasReplacement, $kernel);

    if (substr_count($kernel, $aliasReplacement) !== 1) {
        throw new RuntimeException('The generated modern fixture alias replacement is malformed.');
    }

    if (file_put_contents($kernelPath, $kernel, LOCK_EX) !== strlen($kernel)) {
        throw new RuntimeException('Could not write the modern middleware fixture.');
    }

    $middlewarePath = $directory.'/app/Http/Middleware/E2eProbe.php';
    $middlewareDirectory = dirname($middlewarePath);

    if (! is_dir($middlewareDirectory) && ! mkdir($middlewareDirectory, 0777, true) && ! is_dir($middlewareDirectory)) {
        throw new RuntimeException('Could not create the modern middleware fixture directory.');
    }

    $middleware = <<<'PHP'
<?php

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;

final class E2eProbe
{
    public function handle(Request $request, Closure $next): mixed
    {
        $response = $next($request);
        $response->headers->set('X-Laravel-Upgrade-E2E', 'active');

        return $response;
    }
}
PHP;

    if (file_put_contents($middlewarePath, $middleware."\n", LOCK_EX) !== strlen($middleware) + 1) {
        throw new RuntimeException('Could not write the modern middleware class.');
    }

    $globalMiddlewarePath = $directory.'/app/Http/Middleware/E2eGlobalProbe.php';
    $globalMiddleware = <<<'PHP'
<?php

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;

final class E2eGlobalProbe
{
    public function handle(Request $request, Closure $next): mixed
    {
        $response = $next($request);
        $response->headers->set('X-Laravel-Upgrade-E2E-Global', 'active');

        return $response;
    }
}
PHP;

    if (file_put_contents($globalMiddlewarePath, $globalMiddleware."\n", LOCK_EX) !== strlen($globalMiddleware) + 1) {
        throw new RuntimeException('Could not write the modern global middleware class.');
    }

    $routePath = $directory.'/routes/web.php';
    $routes = file_get_contents($routePath);

    if (! is_string($routes)) {
        throw new RuntimeException('Could not read routes/web.php for the modern fixture.');
    }

    $routes .= "\nRoute::get('/e2e-modern-probe', static fn () => response()->json(['route' => 'e2e-modern-probe']))->middleware('e2e-probe');\n";

    if (file_put_contents($routePath, $routes, LOCK_EX) !== strlen($routes)) {
        throw new RuntimeException('Could not write the modern route fixture.');
    }

    $probePath = $directory.'/modern-structure-probe.php';
    $probe = <<<'PHP'
<?php

use Illuminate\Contracts\Http\Kernel;
use Illuminate\Http\Request;

require __DIR__.'/vendor/autoload.php';

$app = require __DIR__.'/bootstrap/app.php';
$kernel = $app->make(Kernel::class);
$request = Request::create('/e2e-modern-probe', 'GET');
$response = $kernel->handle($request);
$read = static function (object $kernel, string $method): ?array {
    if (! method_exists($kernel, $method)) {
        return null;
    }

    $value = $kernel->{$method}();

    return is_array($value) ? $value : null;
};

echo json_encode([
    'status' => $response->getStatusCode(),
    'body' => json_decode((string) $response->getContent(), true),
    'probe' => $response->headers->get('X-Laravel-Upgrade-E2E'),
    'globalProbe' => $response->headers->get('X-Laravel-Upgrade-E2E-Global'),
    'globalAvailable' => method_exists($kernel, 'getGlobalMiddleware'),
    'groupsAvailable' => method_exists($kernel, 'getMiddlewareGroups'),
    'aliasesAvailable' => method_exists($kernel, 'getMiddlewareAliases'),
    'global' => $read($kernel, 'getGlobalMiddleware'),
    'groups' => $read($kernel, 'getMiddlewareGroups'),
    'aliases' => $read($kernel, 'getMiddlewareAliases'),
], JSON_THROW_ON_ERROR);

$kernel->terminate($request, $response);
PHP;

    if (file_put_contents($probePath, $probe."\n", LOCK_EX) !== strlen($probe) + 1) {
        throw new RuntimeException('Could not write the modern runtime probe.');
    }
}

/** Lint every generated modern fixture before asking Laravel to boot it. */
function lintModernStructureFixture(string $directory): void
{
    foreach ([
        'app/Http/Kernel.php',
        'app/Http/Middleware/E2eProbe.php',
        'app/Http/Middleware/E2eGlobalProbe.php',
        'routes/web.php',
        'routes/api.php',
        'modern-structure-probe.php',
    ] as $relative) {
        $output = run(
            escapeshellarg(PHP_BINARY).' -l '.escapeshellarg($relative),
            $directory,
            $exit,
            120,
        );

        if ($exit !== 0) {
            throw new RuntimeException(sprintf(
                'Generated modern fixture %s failed to lint (exit %d): %s',
                $relative,
                $exit,
                trim($output),
            ));
        }
    }
}

/** @return array<string, mixed> */
function captureModernRuntime(string $directory): array
{
    $routeOutput = run('php artisan route:list --json', $directory, $routeExit, 120);

    if ($routeExit !== 0) {
        throw new RuntimeException(sprintf('modern route:list probe failed with exit %d: %s', $routeExit, trim($routeOutput)));
    }

    $routes = json_decode(trim($routeOutput), true);

    if (! is_array($routes)) {
        throw new RuntimeException('modern route:list probe did not return a JSON array.');
    }

    $output = run('php modern-structure-probe.php', $directory, $exit, 120);

    if ($exit !== 0) {
        throw new RuntimeException(sprintf('modern runtime probe failed with exit %d: %s', $exit, trim($output)));
    }

    $decoded = json_decode(trim($output), true);

    if (! is_array($decoded)) {
        throw new RuntimeException('modern runtime probe did not return a JSON object.');
    }

    $decoded['routes'] = $routes;

    return $decoded;
}

/** @param array<string, mixed> $routes */
function modernRouteSignatures(array $routes): array
{
    $signatures = [];

    foreach ($routes as $route) {
        if (! is_array($route)) {
            continue;
        }

        $signatures[] = [
            'method' => $route['method'] ?? $route['methods'] ?? null,
            'uri' => $route['uri'] ?? null,
            'name' => $route['name'] ?? null,
            'middleware' => normalizeModernRouteMiddleware($route['middleware'] ?? null),
        ];
    }

    usort($signatures, static fn (array $left, array $right): int => strcmp(serialize($left), serialize($right)));

    return $signatures;
}

/** @param array<string, mixed> $routes */
function modernRouteSignaturesWithoutFrameworkRoutes(array $routes): array
{
    return modernRouteSignatures(array_values(array_filter(
        $routes,
        static function (mixed $route): bool {
            if (! is_array($route)) {
                return true;
            }

            $uri = trim((string) ($route['uri'] ?? ''), '/');

            return $uri !== 'up' && $uri !== 'storage/{path}';
        },
    )));
}

function normalizeModernRouteMiddleware(mixed $value): mixed
{
    $map = [
        'App\\Http\\Middleware\\Authenticate' => 'Illuminate\\Auth\\Middleware\\Authenticate',
        'App\\Http\\Middleware\\EncryptCookies' => 'Illuminate\\Cookie\\Middleware\\EncryptCookies',
        'App\\Http\\Middleware\\PreventRequestsDuringMaintenance' => 'Illuminate\\Foundation\\Http\\Middleware\\PreventRequestsDuringMaintenance',
        'App\\Http\\Middleware\\RedirectIfAuthenticated' => 'Illuminate\\Auth\\Middleware\\RedirectIfAuthenticated',
        'App\\Http\\Middleware\\TrimStrings' => 'Illuminate\\Foundation\\Http\\Middleware\\TrimStrings',
        'App\\Http\\Middleware\\TrustHosts' => 'Illuminate\\Http\\Middleware\\TrustHosts',
        'App\\Http\\Middleware\\TrustProxies' => 'Illuminate\\Http\\Middleware\\TrustProxies',
        'App\\Http\\Middleware\\ValidateSignature' => 'Illuminate\\Routing\\Middleware\\ValidateSignature',
        'App\\Http\\Middleware\\VerifyCsrfToken' => 'Illuminate\\Foundation\\Http\\Middleware\\ValidateCsrfToken',
    ];

    if (is_array($value)) {
        foreach ($value as $key => $item) {
            $value[$key] = normalizeModernRouteMiddleware($item);
        }

        return $value;
    }

    if (! is_string($value)) {
        return $value;
    }

    $separator = strpos($value, ':');
    $name = $separator === false ? $value : substr($value, 0, $separator);

    if (! isset($map[$name])) {
        return $value;
    }

    return $map[$name].($separator === false ? '' : substr($value, $separator));
}

/** @param array<string, mixed> $routes
 * @return list<array<string, mixed>>
 */
function modernHealthRoutes(array $routes): array
{
    return array_values(array_filter(
        $routes,
        static fn (mixed $route): bool => is_array($route)
            && trim((string) ($route['uri'] ?? ''), '/') === 'up',
    ));
}

/** @param array<string, mixed> $routes
 * @return list<array<string, mixed>>
 */
function modernStorageRoutes(array $routes): array
{
    return array_values(array_filter(
        $routes,
        static fn (mixed $route): bool => is_array($route)
            && trim((string) ($route['uri'] ?? ''), '/') === 'storage/{path}',
    ));
}

/** @return array<string, mixed> */
function normalizeModernMiddlewareContract(array $runtime): array
{
    $map = [
        'App\\Http\\Middleware\\Authenticate' => 'Illuminate\\Auth\\Middleware\\Authenticate',
        'App\\Http\\Middleware\\EncryptCookies' => 'Illuminate\\Cookie\\Middleware\\EncryptCookies',
        'App\\Http\\Middleware\\PreventRequestsDuringMaintenance' => 'Illuminate\\Foundation\\Http\\Middleware\\PreventRequestsDuringMaintenance',
        'App\\Http\\Middleware\\RedirectIfAuthenticated' => 'Illuminate\\Auth\\Middleware\\RedirectIfAuthenticated',
        'App\\Http\\Middleware\\TrimStrings' => 'Illuminate\\Foundation\\Http\\Middleware\\TrimStrings',
        'App\\Http\\Middleware\\TrustHosts' => 'Illuminate\\Http\\Middleware\\TrustHosts',
        'App\\Http\\Middleware\\TrustProxies' => 'Illuminate\\Http\\Middleware\\TrustProxies',
        'App\\Http\\Middleware\\ValidateSignature' => 'Illuminate\\Routing\\Middleware\\ValidateSignature',
        'App\\Http\\Middleware\\VerifyCsrfToken' => 'Illuminate\\Foundation\\Http\\Middleware\\ValidateCsrfToken',
    ];

    $normalize = static function (mixed $value) use (&$normalize, $map): mixed {
        if (is_array($value)) {
            foreach ($value as $key => $item) {
                $value[$key] = $normalize($item);
            }

            return $value;
        }

        if (! is_string($value)) {
            return $value;
        }

        $separator = strpos($value, ':');
        $name = $separator === false ? $value : substr($value, 0, $separator);

        if (! isset($map[$name])) {
            return $value;
        }

        return $map[$name].($separator === false ? '' : substr($value, $separator));
    };

    $aliases = $normalize($runtime['aliases'] ?? null);

    if (is_array($aliases)) {
        // Alias registration order is not routing behavior; compare it as a map.
        ksort($aliases);
    }

    return [
        'global' => $normalize($runtime['global'] ?? null),
        'groups' => $normalize($runtime['groups'] ?? null),
        'aliases' => $aliases,
    ];
}

/** @param array<string, mixed> $before */
function assertModernRuntimePreserved(array $before, array $after): void
{
    $beforeRoutes = is_array($before['routes'] ?? null) ? $before['routes'] : [];
    $afterRoutes = is_array($after['routes'] ?? null) ? $after['routes'] : [];
    $beforeHealth = modernHealthRoutes($beforeRoutes);
    $afterHealth = modernHealthRoutes($afterRoutes);
    $beforeStorage = modernStorageRoutes($beforeRoutes);
    $afterStorage = modernStorageRoutes($afterRoutes);

    if ($beforeHealth !== []) {
        throw new RuntimeException('the Laravel 10 baseline unexpectedly contains the Laravel 11 /up health route.');
    }

    if (count($afterHealth) !== 1) {
        throw new RuntimeException('the Laravel 11 route:list must contain exactly one /up health route.');
    }

    $healthMethod = $afterHealth[0]['method'] ?? $afterHealth[0]['methods'] ?? null;
    $healthMethods = is_array($healthMethod) ? implode('|', $healthMethod) : (string) $healthMethod;

    if (! str_contains($healthMethods, 'GET')) {
        throw new RuntimeException('the Laravel 11 /up health route must accept GET.');
    }

    if ($beforeStorage !== []) {
        throw new RuntimeException('the Laravel 10 baseline unexpectedly contains the Laravel 11 storage route.');
    }

    if (count($afterStorage) !== 1) {
        throw new RuntimeException('the Laravel 11 route:list must contain exactly one storage/{path} route.');
    }

    $storage = $afterStorage[0];
    $storageMethod = $storage['method'] ?? $storage['methods'] ?? null;
    $storageMethods = is_array($storageMethod) ? implode('|', $storageMethod) : (string) $storageMethod;

    if (($storage['name'] ?? null) !== 'storage.local' || ! str_contains($storageMethods, 'GET')) {
        throw new RuntimeException('the Laravel 11 storage/{path} route must be named storage.local and accept GET.');
    }

    if (modernRouteSignaturesWithoutFrameworkRoutes($beforeRoutes) !== modernRouteSignaturesWithoutFrameworkRoutes($afterRoutes)) {
        throw new RuntimeException('modern migration changed route:list signatures other than the expected framework routes.');
    }

    foreach (['before' => $before, 'after' => $after] as $label => $runtime) {
        if (($runtime['status'] ?? null) !== 200
            || ($runtime['body']['route'] ?? null) !== 'e2e-modern-probe'
            || ($runtime['probe'] ?? null) !== 'active'
            || ($runtime['globalProbe'] ?? null) !== 'active') {
            throw new RuntimeException(sprintf('modern %s runtime probe did not preserve the route/middleware response.', $label));
        }
    }

    $beforeMiddleware = normalizeModernMiddlewareContract($before);
    $afterMiddleware = normalizeModernMiddlewareContract($after);

    if (($before['globalAvailable'] ?? null) !== false || ($before['global'] ?? null) !== null) {
        throw new RuntimeException('the Laravel 10 probe must distinguish an unavailable global accessor from an empty stack.');
    }

    if (($after['globalAvailable'] ?? null) !== true || ! is_array($afterMiddleware['global'] ?? null)) {
        throw new RuntimeException('the Laravel 11 probe did not expose its resolved global middleware stack.');
    }

    $expectedGlobal = [
        'Illuminate\\Http\\Middleware\\TrustProxies',
        'App\\Http\\Middleware\\E2eGlobalProbe',
        'Illuminate\\Http\\Middleware\\HandleCors',
        'Illuminate\\Foundation\\Http\\Middleware\\PreventRequestsDuringMaintenance',
        'Illuminate\\Foundation\\Http\\Middleware\\ValidatePostSize',
        'Illuminate\\Foundation\\Http\\Middleware\\TrimStrings',
        'Illuminate\\Foundation\\Http\\Middleware\\ConvertEmptyStringsToNull',
    ];

    if ($afterMiddleware['global'] !== $expectedGlobal) {
        throw new RuntimeException('modern migration changed the resolved global middleware stack or custom order.');
    }

    foreach (['groups', 'aliases'] as $component) {
        $availableKey = $component.'Available';

        if (($before[$availableKey] ?? null) !== true || ($after[$availableKey] ?? null) !== true) {
            throw new RuntimeException(sprintf('modern %s middleware accessor is unavailable in one runtime probe.', $component));
        }

        if ($beforeMiddleware[$component] !== $afterMiddleware[$component]) {
            throw new RuntimeException(sprintf('modern migration changed the normalized %s middleware contract.', $component));
        }
    }

    if (! in_array('App\\Http\\Middleware\\E2eGlobalProbe', $after['global'], true)
        || ! is_array($beforeMiddleware['groups'] ?? null)
        || ! array_key_exists('web', $beforeMiddleware['groups'])
        || ! array_key_exists('api', $beforeMiddleware['groups'])
        || ! is_array($beforeMiddleware['aliases'] ?? null)
        || ($beforeMiddleware['aliases']['e2e-probe'] ?? null) !== 'App\\Http\\Middleware\\E2eProbe') {
        throw new RuntimeException('modern migration did not preserve the complete middleware contract and custom probes.');
    }
}

/**
 * Changed .php files according to git, NUL-safe including renames.
 *
 * @return list<string>
 */
function changedPhpFiles(string $directory): array
{
    $process = new Process(['git', 'status', '--porcelain=v1', '-z'], $directory);
    $process->run();
    $raw = $process->getOutput();

    $files = [];
    $entries = explode("\0", $raw);

    foreach ($entries as $index => $entry) {
        if ($entry === '') {
            continue;
        }

        // Rename entries carry two paths: "R  old" followed by "new".
        $isRename = (bool) preg_match('/^R\s/', $entry);
        $path = preg_match('/^\\s*[AMDRCT?]+\\s+(.*)$/sD', $entry, $m) === 1 ? $m[1] : trim($entry);

        foreach ([$path, $isRename ? trim($entries[$index + 1] ?? '') : ''] as $candidate) {
            // Deleted files cannot be linted or loaded. They remain visible in
            // git's status, but verification should cover only current files.
            if ($candidate !== '' && str_ends_with($candidate, '.php')
                && is_file($directory.'/'.$candidate)) {
                $files[] = $candidate;
            }
        }
    }

    return array_values(array_unique($files));
}

function treeChecksums(string $directory, bool $ignorePlan = false): array
{
    $checksums = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($directory, FilesystemIterator::SKIP_DOTS)
    );

    foreach ($iterator as $fileInfo) {
        /** @var SplFileInfo $fileInfo */
        $path = $fileInfo->getPathname();

        // Ignore volatile directories: VCS metadata and dependencies.
        if (str_contains($path, '/.git/') || str_contains($path, '/vendor/')
            || str_contains($path, '/node_modules/') || str_contains($path, '/bootstrap/cache/')
            || str_contains($path, '/storage/framework/') || str_contains($path, '/.phpunit.cache')) {
            continue;
        }

        if (! $fileInfo->isFile()) {
            continue;
        }

        $relative = substr($path, strlen($directory) + 1);

        if ($ignorePlan && $relative === '.laravel-upgrade/plan.json') {
            continue;
        }

        $checksums[$relative] = md5_file($path) ?: '';
    }

    ksort($checksums);

    return $checksums;
}

/** @return array<string, mixed> */
function readJsonFile(string $path): array
{
    if (! is_file($path)) {
        throw new RuntimeException(sprintf('Expected JSON file is missing: %s', $path));
    }

    $decoded = json_decode((string) file_get_contents($path), true);

    if (! is_array($decoded)) {
        throw new RuntimeException(sprintf('Expected valid JSON in %s.', $path));
    }

    return $decoded;
}

/** @return array<string, true> */
function reportAppliedRules(string $path): array
{
    $report = readJsonFile($path);
    $rules = [];

    foreach ($report['codeChanges'] ?? [] as $change) {
        if (! is_array($change)) {
            continue;
        }

        foreach ($change['appliedRules'] ?? [] as $rule) {
            if (is_string($rule)) {
                $rules[$rule] = true;
            }
        }
    }

    return $rules;
}

/**
 * Validate the Finding value-object shape before reading fields from a report.
 * The report generator fills defaults for legacy input, so the E2E boundary
 * deliberately checks the canonical serialized shape rather than accepting
 * the lossy defaults used by Finding::fromArray().
 */
function assertFindingEntrySchema(mixed $finding, int $index): void
{
    if (! is_array($finding) || array_is_list($finding)) {
        throw new RuntimeException(sprintf('report.json finding %d must be an object', $index));
    }

    $types = [
        'id' => 'string',
        'ruleId' => 'string',
        'severity' => 'string',
        'laravelVersion' => 'int',
        'file' => 'string',
        'line' => 'int',
        'message' => 'string',
        'action' => 'string',
        'guideUrl' => 'string',
        'autoFixed' => 'bool',
        'confidence' => 'string',
    ];

    foreach ($types as $key => $type) {
        if (! array_key_exists($key, $finding) || get_debug_type($finding[$key]) !== $type) {
            throw new RuntimeException(sprintf('report.json finding %d has an invalid %s', $index, $key));
        }
    }

    if ($finding['id'] === '' || $finding['ruleId'] === '' || str_contains($finding['ruleId'], "\0")) {
        throw new RuntimeException(sprintf('report.json finding %d has an empty or malformed identity', $index));
    }

    if (! in_array($finding['severity'], ['high', 'medium', 'low', 'info'], true)
        || ! in_array($finding['confidence'], ['high', 'medium', 'low'], true)
        || $finding['laravelVersion'] < 1
        || $finding['line'] < 0) {
        throw new RuntimeException(sprintf('report.json finding %d has an invalid severity, confidence, version, or line', $index));
    }

    if (array_key_exists('major', $finding) && ! is_int($finding['major'])) {
        throw new RuntimeException(sprintf('report.json finding %d has an invalid legacy major field', $index));
    }
}

/**
 * Convert a report file to the stable Appendix E finding snapshot format.
 * Empty Finding::file values are the sole project-level representation and
 * become the explicit <project> sentinel; every other path must resolve to a
 * relative path inside the temporary application being upgraded.
 *
 * @return list<array{ruleId: string, file: string}>
 */
function normalizedFindingPairs(array $report, string $projectDirectory): array
{
    if (! array_key_exists('findings', $report)
        || ! is_array($report['findings'])
        || ! array_is_list($report['findings'])) {
        throw new RuntimeException('report.json findings must be a list');
    }

    $pairs = [];

    foreach ($report['findings'] as $index => $finding) {
        assertFindingEntrySchema($finding, $index);

        /** @var array{ruleId: string, file: string} $finding */
        $ruleId = $finding['ruleId'];

        if (trim($ruleId) !== $ruleId) {
            throw new RuntimeException(sprintf('report.json finding %d has whitespace around ruleId', $index));
        }

        $file = normalizeFindingFile($finding['file'], $projectDirectory);
        $pairs[$ruleId."\0".$file] = ['ruleId' => $ruleId, 'file' => $file];
    }

    $pairs = array_values($pairs);
    usort($pairs, static function (array $left, array $right): int {
        return [$left['ruleId'], $left['file']] <=> [$right['ruleId'], $right['file']];
    });

    return $pairs;
}

function normalizeFindingFile(mixed $file, string $projectDirectory): string
{
    if (! is_string($file)) {
        throw new RuntimeException('report.json finding file must be a string');
    }

    if (str_contains($file, "\0")) {
        throw new RuntimeException('report.json finding file contains a NUL byte');
    }

    if (trim($file) !== $file) {
        throw new RuntimeException('report.json finding file has surrounding whitespace');
    }

    $file = str_replace('\\', '/', $file);

    if ($file === '' || $file === '<project>') {
        return '<project>';
    }

    $root = realpath($projectDirectory);

    if (! is_string($root)) {
        throw new RuntimeException('Could not resolve the E2E project root while normalizing findings');
    }

    $root = rtrim(str_replace('\\', '/', $root), '/');
    $isAbsolute = str_starts_with($file, '/') || str_starts_with($file, '~/')
        || $file === '~' || preg_match('/^[A-Za-z]:\//', $file) === 1;

    if ($isAbsolute) {
        if (str_starts_with($file, '~/') || $file === '~') {
            throw new RuntimeException('report.json finding file uses an unresolved home-directory path');
        }

        // realpath handles macOS /var -> /private/var aliases before the
        // containment check, while refusing absolute paths that are missing.
        $resolved = realpath($file);

        if (! is_string($resolved)) {
            throw new RuntimeException(sprintf('report.json absolute finding file cannot be resolved: %s', $file));
        }

        $resolved = str_replace('\\', '/', $resolved);

        if (! isFindingPathWithinRoot($resolved, $root)) {
            throw new RuntimeException(sprintf('report.json finding file is outside the E2E project: %s', $file));
        }

        return relativeFindingPath($resolved, $root, $file);
    }

    while (str_starts_with($file, './')) {
        $file = substr($file, 2);
    }

    $file = validateRelativeFindingPath($file, 'report.json finding file');
    $candidate = $root.'/'.$file;
    $resolved = realpath($candidate);

    if (is_string($resolved)) {
        $resolved = str_replace('\\', '/', $resolved);

        if (! isFindingPathWithinRoot($resolved, $root)) {
            throw new RuntimeException(sprintf('report.json finding file escapes the E2E project through a symlink: %s', $file));
        }

        return relativeFindingPath($resolved, $root, $file);
    }

    // A finding can refer to a file removed by the upgrade. Resolve the
    // longest existing parent so a symlink escape is still rejected, while
    // allowing a genuinely non-existent relative leaf.
    $probe = $candidate;

    while ($probe !== $root && ! file_exists($probe) && ! is_link($probe)) {
        $parent = dirname($probe);

        if ($parent === $probe) {
            break;
        }

        $probe = $parent;
    }

    $resolvedParent = realpath($probe);

    if (is_string($resolvedParent)) {
        $resolvedParent = str_replace('\\', '/', $resolvedParent);

        if (! isFindingPathWithinRoot($resolvedParent, $root)) {
            throw new RuntimeException(sprintf('report.json finding file escapes the E2E project through a symlink: %s', $file));
        }
    } elseif (is_link($probe)) {
        throw new RuntimeException(sprintf('report.json finding file contains an unresolved symlink: %s', $file));
    }

    return $file;
}

function isFindingPathWithinRoot(string $path, string $root): bool
{
    return $path === $root || str_starts_with($path, $root.'/');
}

function relativeFindingPath(string $path, string $root, string $original): string
{
    if ($path === $root) {
        throw new RuntimeException(sprintf('report.json finding file points at the project directory, not a file: %s', $original));
    }

    if (! isFindingPathWithinRoot($path, $root)) {
        throw new RuntimeException(sprintf('report.json finding file is outside the E2E project: %s', $original));
    }

    return validateRelativeFindingPath(substr($path, strlen($root) + 1), 'report.json finding file');
}

function validateRelativeFindingPath(mixed $file, string $label): string
{
    $display = is_scalar($file) || $file === null ? (string) $file : get_debug_type($file);

    if (! is_string($file) || $file === '' || trim($file) !== $file
        || str_contains($file, "\0") || str_starts_with($file, '/')
        || str_starts_with($file, '~/') || $file === '~'
        || preg_match('/^[A-Za-z]:\//', $file) === 1) {
        throw new RuntimeException(sprintf('%s is not a normalized relative path: %s', $label, $display));
    }

    $parts = explode('/', $file);

    if (in_array('', $parts, true) || in_array('.', $parts, true) || in_array('..', $parts, true)) {
        throw new RuntimeException(sprintf('%s is not a normalized relative path: %s', $label, $display));
    }

    return implode('/', $parts);
}

function normalizedFindingSnapshot(array $report, string $projectDirectory): string
{
    return json_encode(
        normalizedFindingPairs($report, $projectDirectory),
        JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR,
    )."\n";
}

/**
 * Parse a committed findings snapshot and require its canonical bytes. This
 * runs before the update flag is consulted so malformed baselines can never
 * be silently replaced by a local update.
 */
function parseExpectedFindingSnapshot(string $contents, string $snapshot): string
{
    $normalizedContents = str_replace(["\r\n", "\r"], "\n", $contents);

    try {
        $decoded = json_decode($contents, true, 512, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException(sprintf('Invalid findings snapshot %s: %s', $snapshot, $exception->getMessage()), 0, $exception);
    }

    if (! is_array($decoded) || ! array_is_list($decoded)) {
        throw new RuntimeException(sprintf('Findings snapshot %s must contain a JSON list', $snapshot));
    }

    $pairs = [];
    $seen = [];

    foreach ($decoded as $index => $pair) {
        if (! is_array($pair) || array_is_list($pair) || array_keys($pair) !== ['ruleId', 'file']) {
            throw new RuntimeException(sprintf('Findings snapshot %s entry %d must be exactly {ruleId,file}', $snapshot, $index));
        }

        if (! is_string($pair['ruleId']) || $pair['ruleId'] === ''
            || trim($pair['ruleId']) !== $pair['ruleId'] || str_contains($pair['ruleId'], "\0")) {
            throw new RuntimeException(sprintf('Findings snapshot %s entry %d has an invalid ruleId', $snapshot, $index));
        }

        $file = validateExpectedFindingPath($pair['file'], $snapshot, $index);
        $identity = $pair['ruleId']."\0".$file;

        if (isset($seen[$identity])) {
            throw new RuntimeException(sprintf('Findings snapshot %s contains duplicate entry %d', $snapshot, $index));
        }

        $seen[$identity] = true;
        $pairs[] = ['ruleId' => $pair['ruleId'], 'file' => $file];
    }

    $sorted = $pairs;
    usort($sorted, static function (array $left, array $right): int {
        return [$left['ruleId'], $left['file']] <=> [$right['ruleId'], $right['file']];
    });

    if ($pairs !== $sorted) {
        throw new RuntimeException(sprintf('Findings snapshot %s is not sorted by ruleId and file', $snapshot));
    }

    $canonical = json_encode(
        $pairs,
        JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR,
    )."\n";

    if ($normalizedContents !== $canonical) {
        throw new RuntimeException(sprintf('Findings snapshot %s is not in canonical JSON form', $snapshot));
    }

    return $canonical;
}

function validateExpectedFindingPath(mixed $file, string $snapshot, int $index): string
{
    if ($file === '<project>') {
        return $file;
    }

    if (! is_string($file) || str_contains($file, '\\')) {
        throw new RuntimeException(sprintf('Findings snapshot %s entry %d has a non-normalized file', $snapshot, $index));
    }

    return validateRelativeFindingPath($file, sprintf('Findings snapshot %s entry %d file', $snapshot, $index));
}

/** @return list<string> */
function canonicalUpgradeSteps(): array
{
    return ['preflight', 'dependencies', 'install', 'skeleton', 'code', 'advisories', 'post', 'verify', 'commit'];
}

/**
 * Validate the plan artifact as an API boundary, including one exact step
 * identity per canonical step and transition.
 *
 * @param  array<string, mixed>  $plan
 */
function assertPlanSchema(array $plan, int $from, int $to): void
{
    foreach (['schemaVersion', 'generatedAt', 'currentMajor', 'targetMajor', 'transitions', 'steps', 'success', 'exitCode', 'failure'] as $key) {
        if (! array_key_exists($key, $plan)) {
            throw new RuntimeException(sprintf('plan.json is missing %s', $key));
        }
    }

    if ($plan['schemaVersion'] !== 1 || ! is_string($plan['generatedAt']) || $plan['generatedAt'] === ''
        || $plan['currentMajor'] !== $from || $plan['targetMajor'] !== $to
        || $plan['success'] !== true || $plan['exitCode'] !== 0
        || strtotime($plan['generatedAt']) === false
        || ! ($plan['failure'] === null || is_string($plan['failure']))) {
        throw new RuntimeException('plan.json has invalid top-level types or values');
    }

    if ($plan['transitions'] !== range($from + 1, $to) || ! is_array($plan['steps'])) {
        throw new RuntimeException('plan.json has invalid transitions or steps');
    }

    $expectedStatuses = [
        'preflight' => 'success',
        'dependencies' => 'success',
        'install' => 'skipped',
        'skeleton' => 'success',
        'code' => 'success',
        'advisories' => 'success',
        'post' => 'success',
        'verify' => 'success',
        'commit' => 'skipped',
    ];
    $seen = [];
    $byTransition = [];

    foreach ($plan['steps'] as $step) {
        if (! is_array($step)
            || ! is_string($step['transition'] ?? null)
            || ! is_int($step['fromMajor'] ?? null)
            || ! is_int($step['toMajor'] ?? null)
            || ! is_string($step['step'] ?? null)
            || ! is_string($step['status'] ?? null)
            || ! is_string($step['message'] ?? null)
            || ! is_array($step['changedFiles'] ?? null)
            || ! is_int($step['findingsCount'] ?? null)
            || $step['findingsCount'] < 0
            || ! is_array($step['data'] ?? null)) {
            throw new RuntimeException('plan.json contains a malformed step entry');
        }

        $identity = $step['transition'].'\0'.$step['step'];

        if (isset($seen[$identity])) {
            throw new RuntimeException(sprintf('plan.json contains duplicate step identity %s', str_replace("\0", '/', $identity)));
        }

        $seen[$identity] = true;
        $byTransition[$step['transition']][$step['step']] = true;
        $expectedTransition = sprintf('%d->%d', $step['fromMajor'], $step['toMajor']);

        if ($step['transition'] !== $expectedTransition
            || ! isset($expectedStatuses[$step['step']])
            || $step['status'] !== $expectedStatuses[$step['step']]) {
            throw new RuntimeException(sprintf('plan.json has an unexpected step identity/status: %s', $identity));
        }

        foreach ($step['changedFiles'] as $file) {
            if (! is_string($file)) {
                throw new RuntimeException('plan.json changedFiles must contain only strings');
            }
        }
    }

    $expectedCount = ($to - $from) * count(canonicalUpgradeSteps());

    if (count($seen) !== $expectedCount) {
        throw new RuntimeException(sprintf('plan.json contains %d steps; expected %d', count($seen), $expectedCount));
    }

    $expectedNames = canonicalUpgradeSteps();

    foreach (range($from + 1, $to) as $major) {
        $transition = sprintf('%d->%d', $major - 1, $major);

        if (array_keys($byTransition[$transition] ?? []) !== $expectedNames) {
            throw new RuntimeException(sprintf('plan.json has unexpected step identities for %s', $transition));
        }
    }
}

/**
 * Assert the operational options that must survive a failed run and be used
 * by a no-override continue invocation.
 *
 * @param  array<string, mixed>  $state
 */
function assertStateOptions(array $state, string $composerProxy, string $structure = 'keep'): void
{
    if (! is_array($state['options'] ?? null)) {
        throw new RuntimeException('state.json options are not an object');
    }

    $expectedOptions = [
        'composerBinary' => $composerProxy,
        'git' => false,
        'noGit' => true,
        'noPint' => true,
        'pint' => false,
        'noTests' => false,
        'noInstall' => false,
        'noInteraction' => true,
        'structure' => $structure,
        'constraintPolicy' => 'replace',
    ];

    foreach ($expectedOptions as $key => $expected) {
        if (($state['options'][$key] ?? null) !== $expected) {
            throw new RuntimeException(sprintf('state.json option %s is not persisted as expected', $key));
        }
    }
}

/**
 * Validate the failed journal before continuing. This deliberately checks
 * operational options so continue cannot silently fall back to global tools.
 *
 * @param  array<string, mixed>  $state
 */
function assertFailedStateSchema(array $state, int $from, int $to, string $composerProxy, string $structure = 'keep'): void
{
    foreach (['schemaVersion', 'runId', 'target', 'currentMajor', 'currentTransition', 'completedSteps', 'changedFiles', 'findingsCount', 'options', 'status', 'failedStep', 'failureMessage', 'startedAt', 'updatedAt', 'timestamps'] as $key) {
        if (! array_key_exists($key, $state)) {
            throw new RuntimeException(sprintf('state.json is missing %s', $key));
        }
    }

    if ($state['schemaVersion'] !== 1 || ! is_string($state['runId']) || $state['runId'] === ''
        || $state['target'] !== $to || $state['currentMajor'] !== $from
        || $state['currentTransition'] !== sprintf('%d->%d', $from, $from + 1)
        || $state['status'] !== 'failed' || $state['failedStep'] !== 'dependencies'
        || ! is_string($state['failureMessage']) || $state['failureMessage'] === ''
        || ! is_string($state['startedAt']) || ! is_string($state['updatedAt'])
        || ! is_array($state['timestamps']) || ! is_string($state['timestamps']['startedAt'] ?? null)
        || ! is_string($state['timestamps']['updatedAt'] ?? null)
        || ! is_array($state['completedSteps']) || ! is_array($state['changedFiles'])
        || ! is_int($state['findingsCount']) || $state['findingsCount'] < 0
        || ! is_array($state['options'])) {
        throw new RuntimeException('state.json has invalid top-level types or values');
    }

    assertStateOptions($state, $composerProxy, $structure);

    $transition = sprintf('%d->%d', $from, $from + 1);
    $completed = $state['completedSteps'][$transition] ?? null;

    if (array_keys($state['completedSteps']) !== [$transition]
        || ! is_array($completed) || array_keys($completed) !== ['preflight']) {
        throw new RuntimeException('state.json does not show a dependency failure after preflight');
    }

    $preflight = $completed['preflight'];

    if (! is_array($preflight) || ($preflight['status'] ?? null) !== 'completed'
        || ! is_string($preflight['message'] ?? null)
        || ! is_string($preflight['completedAt'] ?? null)
        || ! is_array($preflight['changedFiles'] ?? null)
        || ! is_int($preflight['findingsCount'] ?? null)) {
        throw new RuntimeException('state.json contains malformed preflight metadata');
    }

    foreach ($state['changedFiles'] as $file) {
        if (! is_string($file)) {
            throw new RuntimeException('state.json changedFiles must contain only strings');
        }
    }

    foreach (['startedAt', 'updatedAt'] as $timestamp) {
        if (strtotime($state[$timestamp]) === false || strtotime($state['timestamps'][$timestamp]) === false) {
            throw new RuntimeException(sprintf('state.json has an invalid %s timestamp', $timestamp));
        }
    }
}

/**
 * Validate the canonical report after the resumed run. Duplicate identities
 * are rejected instead of being hidden by a last-write-wins map.
 *
 * @param  array<string, mixed>  $report
 */
function assertReportSchema(array $report, int $from, int $to, string $runId): void
{
    foreach (['schemaVersion', 'tool', 'runId', 'project', 'steps', 'dependencies', 'codeChanges', 'skeleton', 'findings', 'verification', 'verificationHistory', 'whatToolDidNotDo', 'startedAt', 'finishedAt', 'updatedAt'] as $key) {
        if (! array_key_exists($key, $report)) {
            throw new RuntimeException(sprintf('report.json is missing %s', $key));
        }
    }

    if ($report['schemaVersion'] !== 1 || ! is_string($report['tool']) || $report['tool'] === ''
        || $report['runId'] !== $runId || ! is_array($report['project'])
        || ! is_array($report['steps']) || ! is_array($report['dependencies'])
        || ! is_array($report['codeChanges']) || ! is_array($report['skeleton'])
        || ! is_array($report['findings']) || ! array_is_list($report['findings'])
        || ! is_array($report['verification'])
        || ! is_array($report['verificationHistory']) || ! is_array($report['whatToolDidNotDo'])
        || ! is_string($report['startedAt']) || $report['startedAt'] === ''
        || strtotime($report['startedAt']) === false
        || ! is_string($report['finishedAt']) || $report['finishedAt'] === ''
        || strtotime($report['finishedAt']) === false
        || ! is_string($report['updatedAt']) || $report['updatedAt'] === ''
        || strtotime($report['updatedAt']) === false) {
        throw new RuntimeException('report.json has invalid top-level types or values');
    }

    foreach ($report['findings'] as $index => $finding) {
        assertFindingEntrySchema($finding, $index);
    }

    $project = $report['project'];

    if (! is_string($project['name'] ?? null) || ! is_string($project['from'] ?? null)
        || ! is_string($project['to'] ?? null) || ! is_string($project['php'] ?? null)
        || ! is_string($project['composer'] ?? null) || ! is_array($project['git'] ?? null)
        || ! is_string($project['git']['branch'] ?? null) || ! is_string($project['git']['base'] ?? null)
        || ($project['from'] ?? null) !== (string) $from || ($project['to'] ?? null) !== (string) $to) {
        throw new RuntimeException('report.json has incorrect project bounds');
    }

    $expectedStatuses = array_merge(
        array_fill_keys(array_slice(canonicalUpgradeSteps(), 0, -1), 'ok'),
        ['commit' => 'skipped'],
    );
    $seen = [];
    $byTransition = [];

    foreach ($report['steps'] as $step) {
        if (! is_array($step)
            || ! is_string($step['transition'] ?? null)
            || ! is_int($step['major'] ?? null)
            || ! is_int($step['fromMajor'] ?? null)
            || ! is_int($step['toMajor'] ?? null)
            || ! is_string($step['name'] ?? null)
            || ! is_string($step['status'] ?? null)
            || ! is_array($step['changedFiles'] ?? null)
            || ! is_array($step['commands'] ?? null)
            || ! is_string($step['message'] ?? null)
            || ! is_int($step['findingsCount'] ?? null)
            || $step['findingsCount'] < 0
            || ! (($step['exitCode'] ?? null) === null || is_int($step['exitCode']))
            || ! is_int($step['durationMs'] ?? null)
            || ! is_string($step['recordedAt'] ?? null)
            || ! is_array($step['data'] ?? null)) {
            throw new RuntimeException('report.json contains a malformed step entry');
        }

        $identity = $step['transition'].'\0'.$step['name'];

        if (isset($seen[$identity])) {
            throw new RuntimeException(sprintf('report.json contains duplicate step identity %s', str_replace("\0", '/', $identity)));
        }

        $seen[$identity] = true;
        $expectedTransition = sprintf('%d->%d', $step['fromMajor'], $step['toMajor']);

        if ($step['transition'] !== $expectedTransition || $step['major'] !== $step['toMajor']
            || ! isset($expectedStatuses[$step['name']])
            || $step['status'] !== $expectedStatuses[$step['name']]) {
            throw new RuntimeException(sprintf('report.json has an unexpected step identity/status: %s', $identity));
        }

        foreach ($step['changedFiles'] as $file) {
            if (! is_string($file)) {
                throw new RuntimeException('report.json changedFiles must contain only strings');
            }
        }

        foreach ($step['commands'] as $command) {
            if (! is_array($command) || ! is_string($command['cmd'] ?? null)
                || ! is_array($command['argv'] ?? null)
                || ! (($command['exit'] ?? null) === null || is_int($command['exit']))) {
                throw new RuntimeException('report.json contains malformed command metadata');
            }
        }

        if ($step['name'] === 'commit'
            && (($step['data']['git']['reason'] ?? null) !== 'noGit')) {
            throw new RuntimeException('report.json does not record the commit as explicitly skipped by --no-git');
        }

        $byTransition[$step['transition']][$step['name']] = true;
    }

    $expectedNames = canonicalUpgradeSteps();

    foreach (range($from + 1, $to) as $major) {
        $transition = sprintf('%d->%d', $major - 1, $major);

        if (array_keys($byTransition[$transition] ?? []) !== $expectedNames) {
            throw new RuntimeException(sprintf('report.json has unexpected step identities for %s', $transition));
        }
    }

    if (count($seen) !== ($to - $from) * count($expectedNames)) {
        throw new RuntimeException('report.json has an unexpected number of steps');
    }
}

/** @param list<int> $allowedExitCodes */
function gitOutput(string $directory, array $arguments, array $allowedExitCodes = [0]): string
{
    $process = new Process(array_merge(['git'], $arguments), $directory);
    $process->run();
    $exitCode = $process->getExitCode() ?? 1;

    if (! in_array($exitCode, $allowedExitCodes, true)) {
        throw new RuntimeException(sprintf(
            'git %s failed with exit code %d: %s',
            implode(' ', $arguments),
            $exitCode,
            trim($process->getErrorOutput()),
        ));
    }

    return $process->getOutput();
}

function snapshotPathExcluded(string $relative): bool
{
    // Composer lockfile churn is covered by validate/solver assertions;
    // dependency resolution metadata is intentionally not snapshot noise.
    return $relative === 'UPGRADE-REPORT.md'
        || $relative === 'composer.lock'
        || $relative === 'database/database.sqlite'
        || str_starts_with($relative, '.laravel-upgrade/')
        || str_starts_with($relative, 'bootstrap/cache/')
        || str_starts_with($relative, 'storage/framework/')
        || str_starts_with($relative, 'storage/logs/')
        || str_starts_with($relative, '.e2e-composer');
}

/**
 * Return a stable unified diff for project changes. Tracked changes come from
 * git diff; relevant untracked files are rendered with git diff --no-index so
 * skeleton additions are covered too.
 */
function normalizedUpgradeDiff(string $directory): string
{
    $diff = gitOutput($directory, [
        'diff',
        '--no-ext-diff',
        '--no-color',
        '--unified=3',
        '--',
        '.',
        ':(exclude).laravel-upgrade/**',
        ':(exclude)UPGRADE-REPORT.md',
        ':(exclude)composer.lock',
        ':(exclude).e2e-composer*',
        ':(exclude)bootstrap/cache/**',
        ':(exclude)storage/framework/**',
        ':(exclude)storage/logs/**',
        ':(exclude)database/database.sqlite',
    ]);
    $untracked = gitOutput($directory, ['ls-files', '--others', '--exclude-standard', '-z']);

    foreach (array_filter(explode("\0", $untracked), static fn (string $path): bool => $path !== '') as $relative) {
        $relative = str_replace('\\', '/', $relative);

        if (snapshotPathExcluded($relative)) {
            continue;
        }

        $single = gitOutput($directory, ['diff', '--no-index', '--no-color', '--unified=3', '--', '/dev/null', $relative], [0, 1]);
        $single = preg_replace('/^diff --git .*$/m', 'diff --git a/'.$relative.' b/'.$relative, $single) ?? $single;
        $single = preg_replace('/^--- .*$/m', '--- /dev/null', $single) ?? $single;
        $single = preg_replace('/^\+\+\+ .*$/m', '+++ b/'.$relative, $single) ?? $single;
        $diff .= $single;
    }

    $diff = str_replace(["\r\n", "\r"], "\n", $diff);
    $diff = str_replace($directory.'/', '<E2E_PROJECT>/', $diff);
    $diff = preg_replace('/^index [0-9a-f]+\.\.[0-9a-f]+.*$/mi', 'index <hash>..<hash>', $diff) ?? $diff;
    $diff = preg_replace('/^([+-].*"content-hash"\s*:\s*")[0-9a-f]+(").*$/mi', '$1<content-hash>$2', $diff) ?? $diff;
    $diff = preg_replace('/e2e-\d+-\d+-\d+/', 'e2e-<run>', $diff) ?? $diff;

    return rtrim($diff)."\n";
}

function assertDiffSnapshot(string $directory, string $repoRoot, int $from, int $to, string $structure = 'keep'): void
{
    $suffix = $structure === 'modern' ? '-modern' : '';
    $snapshot = $repoRoot.'/tests/E2E/expected/'.$from.'-'.$to.$suffix.'.diff';
    $actual = normalizedUpgradeDiff($directory);
    $update = e2eSnapshotUpdateEnabled('LARAVEL_E2E_UPDATE_DIFF_SNAPSHOTS');

    if (! is_file($snapshot)) {
        if ($update && file_put_contents($snapshot, $actual) !== false) {
            echo "  wrote {$snapshot} (review this live baseline before committing)\n";

            return;
        }

        throw new RuntimeException(sprintf(
            'Missing normalized diff snapshot %s. Run this live E2E with LARAVEL_E2E_UPDATE_DIFF_SNAPSHOTS=1 locally after reviewing the result.',
            $snapshot,
        ));
    }

    $expected = file_get_contents($snapshot);

    if (! is_string($expected)) {
        throw new RuntimeException(sprintf('Could not read normalized diff snapshot %s.', $snapshot));
    }

    $expected = rtrim(str_replace(["\r\n", "\r"], "\n", $expected))."\n";

    if ($expected === $actual) {
        return;
    }

    if ($update && file_put_contents($snapshot, $actual) !== false) {
        echo "  updated {$snapshot} (review this live baseline before committing)\n";

        return;
    }

    throw new RuntimeException(sprintf(
        'Normalized diff differs from %s. Re-run locally with LARAVEL_E2E_UPDATE_DIFF_SNAPSHOTS=1 after reviewing the project diff.',
        $snapshot,
    ));
}

function e2eSnapshotUpdateEnabled(string $environmentVariable): bool
{
    $update = getenv($environmentVariable) === '1';

    if (! $update) {
        return false;
    }

    $ci = static function (string $name): bool {
        return in_array(strtolower(trim((string) getenv($name))), ['1', 'true', 'yes'], true);
    };

    if ($ci('CI') || $ci('GITHUB_ACTIONS')) {
        throw new RuntimeException(sprintf(
            'Refusing to rewrite E2E snapshots in CI; unset %s.',
            $environmentVariable,
        ));
    }

    return true;
}

function assertFindingsSnapshot(string $directory, string $repoRoot, int $from, int $to, string $structure = 'keep'): void
{
    $suffix = $structure === 'modern' ? '-modern' : '';
    $snapshot = $repoRoot.'/tests/E2E/expected/'.$from.'-'.$to.$suffix.'-findings.json';
    $report = readJsonFile($directory.'/.laravel-upgrade/report.json');
    $actual = normalizedFindingSnapshot($report, $directory);

    if (! is_file($snapshot)) {
        $update = e2eSnapshotUpdateEnabled('LARAVEL_E2E_UPDATE_FINDING_SNAPSHOTS');

        if ($update && file_put_contents($snapshot, $actual) !== false) {
            echo "  wrote {$snapshot} (review this live baseline before committing)\n";

            return;
        }

        throw new RuntimeException(sprintf(
            'Missing normalized findings snapshot %s. Run this live E2E with LARAVEL_E2E_UPDATE_FINDING_SNAPSHOTS=1 locally after reviewing the result.',
            $snapshot,
        ));
    }

    $expected = file_get_contents($snapshot);

    if (! is_string($expected)) {
        throw new RuntimeException(sprintf('Could not read normalized findings snapshot %s.', $snapshot));
    }

    $expected = parseExpectedFindingSnapshot($expected, $snapshot);
    $update = e2eSnapshotUpdateEnabled('LARAVEL_E2E_UPDATE_FINDING_SNAPSHOTS');

    if ($expected === $actual) {
        return;
    }

    if ($update && file_put_contents($snapshot, $actual) !== false) {
        echo "  updated {$snapshot} (review this live baseline before committing)\n";

        return;
    }

    throw new RuntimeException(sprintf(
        'Normalized findings differ from %s. Re-run locally with LARAVEL_E2E_UPDATE_FINDING_SNAPSHOTS=1 after reviewing the result.',
        $snapshot,
    ));
}

function sourceSkeletonVersion(int $major): string
{
    $versions = [
        10 => 'v10.3.3',
        11 => 'v11.6.1',
        12 => 'v12.12.2',
    ];

    if (! array_key_exists($major, $versions)) {
        throw new RuntimeException(sprintf('No reviewed Laravel skeleton version is mapped for major %d.', $major));
    }

    return $versions[$major];
}

require $repoRoot.'/vendor/autoload.php';

$app = sys_get_temp_dir().'/e2e-'.$from.'-'.$to.'-'.time();
$sourceVersion = sourceSkeletonVersion($from);

echo "Creating Laravel {$sourceVersion} skeleton at {$app}...\n";

// Composer >= 2.10 blocks Laravel 10/11 resolution through security advisories;
// disable before any composer command runs.
putenv('COMPOSER_POLICY_ADVISORIES_BLOCK=false');
$_ENV['COMPOSER_POLICY_ADVISORIES_BLOCK'] = 'false';

run(sprintf(
    'composer create-project laravel/laravel %s %s --no-scripts --no-interaction --prefer-dist',
    escapeshellarg($app),
    escapeshellarg($sourceVersion),
), $repoRoot, $createExit, 1800);

if ($createExit !== 0 || ! is_file($app.'/artisan')) {
    fwrite(STDERR, sprintf("create-project failed (exit %d).\n", $createExit));

    exit(1);
}

// Ensure vendor dependencies are installed (--no-scripts may skip autoload).
if (! is_file($app.'/vendor/autoload.php')) {
    putenv('COMPOSER_POLICY_ADVISORIES_BLOCK=false');
    $_ENV['COMPOSER_POLICY_ADVISORIES_BLOCK'] = 'false';
    run('composer update --no-interaction --no-progress', $app, $updExit, 1800);

    if ($updExit !== 0) {
        fwrite(STDERR, sprintf("Initial composer update failed (exit %d).\n", $updExit));

        exit(1);
    }
}

// Disable advisory blocking for subsequent dependency changes.
run('composer config policy.advisories.block false', $app, $policyExit);

if ($policyExit !== 0) {
    fwrite(STDERR, "Could not disable Composer advisory blocking.\n");

    exit(1);
}

// --no-scripts skipped the env setup: provide .env and an application key.
if (! is_file($app.'/.env') && is_file($app.'/.env.example')) {
    copy($app.'/.env.example', $app.'/.env');
}

run('php artisan key:generate --quiet', $app, $keyExit, 120);

if ($keyExit !== 0) {
    fwrite(STDERR, "key:generate failed\n");

    exit(1);
}

echo "Planting upgrade-triggering files...\n";
$plantsSource = $repoRoot.'/tests/E2E/plants/'.$from;

if (! is_dir($plantsSource)) {
    fwrite(STDERR, sprintf("No E2E plant directory exists for Laravel %d.\n", $from));

    exit(1);
}

foreach (
    new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($plantsSource, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::LEAVES_ONLY
    ) as $plantFile
) {
    /** @var SplFileInfo $plantFile */
    $target = $app.'/'.substr($plantFile->getPathname(), strlen($plantsSource) + 1);
    $targetDirectory = dirname($target);

    if (! is_dir($targetDirectory)) {
        mkdir($targetDirectory, 0777, true);
    }

    copy($plantFile->getPathname(), $target);
}

/** @var array<string, mixed>|null $modernBaseline */
$modernBaseline = null;

if ($structure === 'modern') {
    prepareModernStructureFixture($app);
    lintModernStructureFixture($app);
    $modernBaseline = captureModernRuntime($app);
}

run('git init -q', $app, $gitExit);

if ($gitExit !== 0) {
    fwrite(STDERR, "Could not initialize the E2E git repository.\n");

    exit(1);
}

// Keep commit metadata reproducible on developer machines and CI runners.
run('git config user.name "Laravel Upgrade E2E"', $app, $gitConfigExit);

if ($gitConfigExit !== 0) {
    fwrite(STDERR, "Could not configure the E2E git author name.\n");

    exit(1);
}

run('git config user.email "laravel-upgrade-e2e@example.test"', $app, $gitConfigExit);

if ($gitConfigExit !== 0) {
    fwrite(STDERR, "Could not configure the E2E git author email.\n");

    exit(1);
}

run('git add -A && git commit -qm base', $app, $gitExit);

if ($gitExit !== 0) {
    fwrite(STDERR, "Could not create the E2E git baseline.\n");

    exit(1);
}

echo "Installing package from local checkout...\n";
run('composer config repositories.local path '.escapeshellarg($repoRoot), $app, $repoExit);

if ($repoExit !== 0) {
    fwrite(STDERR, "Could not register the local package repository.\n");

    exit(1);
}

// PHPStan is a package dependency of the orchestrator's advisory step, not a
// transitive require-dev dependency of a path package. Install it explicitly
// so the real advisory engine runs in this app instead of being skipped.
run(
    'composer require --dev muhammadsadeeq/laravel-upgrades-rector:"*@dev" phpstan/phpstan:"^2.1" --no-interaction --no-progress',
    $app,
    $packageExit,
    1800,
);

if ($packageExit !== 0) {
    fwrite(STDERR, "Could not install the local package and PHPStan.\n");

    exit(1);
}

// The package bootstrap is part of the test fixture, not the upgrade under
// test. Commit it so `to` can enforce a clean baseline while leaving the
// upgrade's own changes visible to the legacy assertions below.
run('git add composer.json composer.lock && git commit -qm tooling', $app, $toolingExit);

if ($toolingExit !== 0) {
    fwrite(STDERR, "Could not commit the E2E tooling baseline.\n");

    exit(1);
}

check('to --plan is byte-neutral except for plan.json', static function () use ($app, $from, $to, $structure): void {
    $before = treeChecksums($app, true);
    run(sprintf(
        'vendor/bin/laravel-upgrade to %d --plan --structure=%s --no-interaction --no-tests --no-pint --no-git',
        $to,
        escapeshellarg($structure),
    ), $app, $exit, 1800);

    if ($exit !== 0) {
        throw new RuntimeException("to --plan exited {$exit}");
    }

    $after = treeChecksums($app, true);

    if ($before !== $after) {
        throw new RuntimeException('to --plan modified files other than its plan artifact');
    }

    $plan = readJsonFile($app.'/.laravel-upgrade/plan.json');

    assertPlanSchema($plan, $from, $to);
});

