# Advisory rules for Laravel 11 (and Carbon 3 when that package is installed).
# Keep version-specific registrations here; the orchestrator may add the
# target package neon and project context parameters at runtime.
parameters:
    level: 0
    reportUnmatchedIgnoredErrors: false

services:
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\ColumnChangeRequiresModifiersRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\EloquentCastsMethodConflictRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\SchemaGetColumnTypeRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\DoctrineRemovedMethodsRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\AuthenticationExceptionRedirectToRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\EnumerableDumpSignatureRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\EmailVerificationAutoRegistrationRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\PublishesConfigAppProvidersRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\PasswordRehashCustomColumnRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\CashierSubscriptionCancelEndsTrialRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\PassportRoutesRemovedRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\CarbonUntypedDiffRule
        tags: [phpstan.rules.rule]
    afterCommitWithSyncQueueRule:
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\AfterCommitWithSyncQueueRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\MariaDbUuidColumnRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\FloatPrecisionDroppedRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\SpatialGeographyReviewRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\DiffForHumansOptionsRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\CarbonIntervalFloatSupportRule
        tags: [phpstan.rules.rule]
    -
        class: MuhammadSadeeq\LaravelUpgradesRector\PHPStan\Rules\SetTestNowCopySemanticsRule
        tags: [phpstan.rules.rule]
