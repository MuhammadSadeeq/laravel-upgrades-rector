parameters:
    level: max
    paths:
        - src
        - tests

    excludePaths:
        - stubs

    # Rector bundles its own PhpParser version which may differ from
    # the one PHPStan sees (especially with composer's --prefer-lowest in CI).
    # This causes false positives about PhpParser\Node types.
    treatPhpDocTypesAsCertain: false
