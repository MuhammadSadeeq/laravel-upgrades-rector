{
    "name": "muhammadsadeeq/laravel-upgrades-rector",
    "description": "Automated Laravel upgrade tool: Rector rules, PHPStan advisories, and a CLI orchestrator for Laravel 10 through 13.",
    "type": "rector-extension",
    "keywords": [
        "laravel",
        "rector",
        "upgrade",
        "migration",
        "automation",
        "refactoring",
        "php"
    ],
    "license": "MIT",
    "homepage": "https://github.com/muhammadsadeeq/laravel-upgrades-rector",
    "support": {
        "issues": "https://github.com/muhammadsadeeq/laravel-upgrades-rector/issues",
        "source": "https://github.com/muhammadsadeeq/laravel-upgrades-rector",
        "docs": "https://github.com/muhammadsadeeq/laravel-upgrades-rector/blob/main/README.md"
    },
    "authors": [
        {
            "name": "Muhammad Sadeeq",
            "email": "afridi.sadeeq.m@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "rector/rector": "^2.3",
        "composer/semver": "^3.4",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0",
        "symplify/rule-doc-generator-contracts": "^11.0",
        "composer/metadata-minifier": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10 || ^2.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.30",
        "driftingly/rector-laravel": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "MuhammadSadeeq\\LaravelUpgradesRector\\": "src/"
        }
    },
    "bin": [
        "bin/laravel-upgrade"
    ],
    "autoload-dev": {
        "psr-4": {
            "MuhammadSadeeq\\LaravelUpgradesRector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "rector": {
            "includes": [
                "config/config.php"
            ]
        }
    },
    "scripts": {
        "test": [
            "@test-env-11",
            "@test-env-12",
            "@test-env-13",
            "@test-phpstan-11",
            "@test-phpstan-12",
            "@test-phpstan-13",
            "@test-independent"
        ],
        "test-env-11": [
            "LARAVEL_ENV=11 phpunit --testsuite env-11",
            "LARAVEL_ENV=11 phpunit tests/Support/GeneratedCodeLoadsTest.php"
        ],
        "test-env-12": [
            "LARAVEL_ENV=12 phpunit --testsuite env-12",
            "LARAVEL_ENV=12 phpunit tests/Support/GeneratedCodeLoadsTest.php"
        ],
        "test-env-13": [
            "LARAVEL_ENV=13 phpunit --testsuite env-13",
            "LARAVEL_ENV=13 phpunit tests/Support/GeneratedCodeLoadsTest.php"
        ],
        "test-phpstan": [
            "@test-phpstan-11",
            "@test-phpstan-12",
            "@test-phpstan-13"
        ],
        "test-phpstan-11": "LARAVEL_ENV=11 phpunit --testsuite phpstan",
        "test-phpstan-12": "LARAVEL_ENV=12 phpunit --testsuite phpstan",
        "test-phpstan-13": "LARAVEL_ENV=13 phpunit --testsuite phpstan",
        "test-independent": "phpunit --testsuite independent",
        "format": "pint",
        "format-test": "pint --test",
        "analyse": "phpstan analyse --level max",
        "check-support-policy": "php bin/check-support-policy",
        "check-release": "php bin/check-release",
        "check-guide-drift": "php bin/check-guide-drift",
        "build-compat-matrix": "php bin/build-compat-matrix --write"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {}
    }
}
